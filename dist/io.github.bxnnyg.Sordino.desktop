[Desktop Entry]
Type=Application
Name=Sordino
GenericName=Microphone noise suppression
GenericName[de]=Mikrofon-Rauschunterdrückung
Comment=Clean microphone audio for calls with one switch
Comment[de]=Sauberer Mikrofonton für Calls mit einem Schalter
Exec=sordino
Icon=io.github.bxnnyg.Sordino
Terminal=false
Categories=AudioVideo;Audio;
Keywords=microphone;noise;krisp;rnnoise;pipewire;mikrofon;rauschen;
StartupWMClass=sordino
Actions=mute;panic;mode-call;mode-streaming;mode-recording;

[Desktop Action mute]
Name=Mute microphone (toggle)
Name[de]=Mikro stumm (umschalten)
Exec=sordinoctl mute

[Desktop Action panic]
Name=Mute everything: microphone and headphones (toggle)
Name[de]=Alles stumm: Mikro und Kopfhörer (umschalten)
Exec=sordinoctl panic

[Desktop Action mode-call]
Name=Mode: Call
Name[de]=Modus: Call
Exec=sordinoctl mode call

[Desktop Action mode-streaming]
Name=Mode: Streaming
Name[de]=Modus: Streaming
Exec=sordinoctl mode streaming

[Desktop Action mode-recording]
Name=Mode: Recording
Name[de]=Modus: Aufnahme
Exec=sordinoctl mode recording
